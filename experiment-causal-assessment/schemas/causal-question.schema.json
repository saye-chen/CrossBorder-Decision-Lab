{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crossborder-decision-lab.local/ecae/schemas/causal-question.schema.json",
  "title":"Causal question",
  "allOf":[{"$ref":"common-object.schema.json#/$defs/baseObject"}],
  "type":"object",
  "required":["question_type","decision_owner","decision_to_change","treatment","comparator","population_ref","outcome_refs","time_horizon","target_claim_level","estimand_ref","causal_graph_ref"],
  "properties":{
    "question_type":{"enum":["descriptive","associational","predictive","attributed","causal"]},
    "decision_owner":{"type":"string","minLength":1},
    "decision_to_change":{"type":"string","minLength":1},
    "decision_deadline":{"type":"string","format":"date-time"},
    "treatment":{"type":"object","required":["name","version","operational_definition"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"operational_definition":{"type":"string","minLength":1}},"additionalProperties":false},
    "comparator":{"type":"object","required":["name","version","operational_definition"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"operational_definition":{"type":"string","minLength":1}},"additionalProperties":false},
    "population_ref":{"type":"string","minLength":1},
    "outcome_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "time_horizon":{"type":"object","required":["time_origin","follow_up","maturity_lag"],"properties":{"time_origin":{"type":"string","minLength":1},"follow_up":{"type":"string","minLength":1},"maturity_lag":{"type":"string","minLength":1}},"additionalProperties":false},
    "target_claim_level":{"type":"string","enum":["CE0","CE1","CE2","CE3","CE4","CE5"]},
    "estimand_ref":{"type":"string","minLength":1},
    "causal_graph_ref":{"type":"string","minLength":1},
    "minimum_important_effect":{"$ref":"common-object.schema.json#/$defs/semanticValue"},
    "maximum_acceptable_harm":{"$ref":"common-object.schema.json#/$defs/semanticValue"}
  },
  "unevaluatedProperties":false
}
