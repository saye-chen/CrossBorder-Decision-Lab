{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crossborder-decision-lab.local/ecae/schemas/causal-analysis-result.schema.json",
  "title":"Causal analysis result",
  "allOf":[{"$ref":"common-object.schema.json#/$defs/baseObject"}],
  "type":"object",
  "required":["protocol_ref","analysis_plan_ref","dataset_manifest_ref","estimand_ref","method","capability_tier","estimate","effect_scale","interval","sample_support","diagnostic_refs","sensitivity_refs","deviation_refs","causal_evidence_grade","claim_ceiling","allowed_wording","prohibited_wording","reproducibility_bundle_ref","review_status"],
  "properties":{
    "protocol_ref":{"type":"string","minLength":1},
    "analysis_plan_ref":{"type":"string","minLength":1},
    "dataset_manifest_ref":{"type":"string","minLength":1},
    "estimand_ref":{"type":"string","minLength":1},
    "method":{"type":"string","minLength":1},
    "capability_tier":{"enum":["native_executable","verified_backend","protocol_only","research_only"]},
    "backend_proof_ref":{"type":"string","minLength":1},
    "estimate":{"$ref":"common-object.schema.json#/$defs/semanticValue"},
    "effect_scale":{"enum":["mean_difference","risk_difference","risk_ratio","odds_ratio","rate_ratio","log_ratio","elasticity","currency_difference","policy_value"]},
    "interval":{"type":"object","required":["level","lower","upper","method"],"properties":{"level":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},"lower":{"type":"number"},"upper":{"type":"number"},"method":{"type":"string","minLength":1}},"additionalProperties":false},
    "sample_support":{"type":"object","required":["units","events","clusters","support_scope"],"properties":{"units":{"type":"integer","minimum":0},"events":{"$ref":"common-object.schema.json#/$defs/semanticValue"},"clusters":{"$ref":"common-object.schema.json#/$defs/semanticValue"},"support_scope":{"type":"string","minLength":1}},"additionalProperties":false},
    "diagnostic_refs":{"type":"array","items":{"type":"string","minLength":1}},
    "sensitivity_refs":{"type":"array","items":{"type":"string","minLength":1}},
    "deviation_refs":{"type":"array","items":{"type":"string","minLength":1}},
    "causal_evidence_grade":{"enum":["CE0","CE1","CE2","CE3","CE4","CE5"]},
    "claim_ceiling":{"type":"string","minLength":1},
    "allowed_wording":{"type":"array","items":{"type":"string","minLength":1}},
    "prohibited_wording":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "economic_interpretation_ref":{"type":"string","minLength":1},
    "reproducibility_bundle_ref":{"type":"string","minLength":1},
    "review_status":{"enum":["unreviewed","internal_reviewed","independent_accepted","independent_conditional","independent_rejected"]}
  },
  "unevaluatedProperties":false
}
