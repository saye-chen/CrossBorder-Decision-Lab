{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ecae/schemas/backend-execution-result.schema.json",
  "title": "Scientific backend execution result envelope",
  "type": "object",
  "required": ["schema_version", "backend_id", "candidate_id", "package", "version", "ok", "result", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "backend_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"},
    "result": {"type": ["object", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {"properties": {"result": {"type": "object"}, "error": {"type": "null"}}},
      "else": {"required": ["error"], "properties": {"result": {"type": "null"}, "error": {"type": "object"}}}
    }
  ]
}
