{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ecae/schemas/backend-proof.schema.json",
  "title": "Scientific backend verification proof",
  "type": "object",
  "required": ["schema_version", "proof_id", "backend_id", "candidate_id", "package", "version", "environment_hash", "adapter_hash", "contract_hash", "parity_suite", "numerical_tolerances", "failure_semantics", "seed_contract", "verified_at", "expires_at", "review"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proof_id": {"type": "string", "minLength": 1},
    "backend_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "environment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parity_suite": {
      "type": "object",
      "required": ["analytical_truth", "independent_implementation", "adversarial", "mutation", "simulation", "status"],
      "properties": {
        "analytical_truth": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "independent_implementation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "adversarial": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "mutation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "simulation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"const": "pass"}
      },
      "additionalProperties": false
    },
    "numerical_tolerances": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "failure_semantics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "seed_contract": {"type": "object", "minProperties": 1},
    "verified_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "review": {
      "type": "object",
      "required": ["status", "reviewer_independent", "scope"],
      "properties": {
        "status": {"const": "accepted"},
        "reviewer_independent": {"const": true},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
