{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ecae/schemas/backend-registry.schema.json",
  "title": "Fail-closed scientific backend registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "policy", "as_of_time", "lock_ref", "verification_requirements", "backends"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "policy": {"const": "fail_closed"},
    "as_of_time": {"type": "string", "format": "date-time"},
    "lock_ref": {"type": "string", "pattern": "^backends/backend-lock\\.json$"},
    "verification_requirements": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["backend_id", "methods", "status", "selected_candidate_id", "package", "version", "ecosystem", "runtime", "parity_evidence_ref", "verified_at", "expires_at", "reason"],
        "properties": {
          "backend_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["unavailable", "candidate_locked", "runtime_unavailable", "installed_unverified", "verified", "expired", "rejected"]},
          "selected_candidate_id": {"type": ["string", "null"]},
          "package": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "ecosystem": {"enum": ["cran", "pypi", "github", "unbound"]},
          "runtime": {
            "type": "object",
            "required": ["kind", "minimum_version"],
            "properties": {
              "kind": {"enum": ["r", "python", "unbound"]},
              "minimum_version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "adapter_ref": {"type": ["string", "null"]},
          "parity_evidence_ref": {"type": ["string", "null"]},
          "verified_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "verified"}}},
            "then": {
              "required": ["adapter_ref"],
              "properties": {
                "selected_candidate_id": {"type": "string", "minLength": 1},
                "parity_evidence_ref": {"type": "string", "minLength": 1},
                "verified_at": {"type": "string", "format": "date-time"},
                "expires_at": {"type": "string", "format": "date-time"},
                "adapter_ref": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
