{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crossborder-decision-lab.local/ecae/schemas/diagnostic-result.schema.json",
  "title":"Diagnostic result",
  "allOf":[{"$ref":"common-object.schema.json#/$defs/baseObject"}],
  "type":"object",
  "required":["analysis_ref","diagnostic_type","status","severity","method","statistic","threshold_contract","evidence_refs","claim_impact","remediation"],
  "properties":{
    "analysis_ref":{"type":"string","minLength":1},
    "diagnostic_type":{"enum":["srm","assignment_integrity","exposure_reconciliation","maturity","missingness","attrition","contamination","interference","pretrend","placebo","negative_control","overlap","balance","weak_instrument","rdd_manipulation","pre_fit","carryover","serial_dependence","multiplicity","backend_parity","numerical_stability"]},
    "status":{"enum":["pass","fail","warning","unknown","not_applicable"]},
    "severity":{"enum":["information","degrade","block_ce5","block_causal"]},
    "method":{"type":"string","minLength":1},
    "statistic":{"$ref":"common-object.schema.json#/$defs/semanticValue"},
    "threshold_contract":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "claim_impact":{"type":"string","minLength":1},
    "remediation":{"type":"string","minLength":1}
  },
  "unevaluatedProperties":false
}
