{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crossborder-decision-lab.local/ecae/schemas/sensitivity-result.schema.json",
  "title":"Sensitivity result",
  "allOf":[{"$ref":"common-object.schema.json#/$defs/baseObject"}],
  "type":"object",
  "required":["analysis_ref","threat","method","parameter_grid","results","robustness_summary","tipping_point","claim_impact"],
  "properties":{
    "analysis_ref":{"type":"string","minLength":1},
    "threat":{"enum":["unmeasured_confounding","parallel_trends","donor_pool","bandwidth","functional_form","overlap_trimming","missing_not_at_random","carryover","interference","measurement_error","surrogate_validity","transport"]},
    "method":{"type":"string","minLength":1},
    "parameter_grid":{"type":"array","minItems":1,"items":{"type":"object"}},
    "results":{"type":"array","minItems":1,"items":{"type":"object"}},
    "robustness_summary":{"type":"string","minLength":1},
    "tipping_point":{"$ref":"common-object.schema.json#/$defs/semanticValue"},
    "claim_impact":{"enum":["none","limit_scope","degrade_one_level","block_ce5","block_causal"]}
  },
  "unevaluatedProperties":false
}
