{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crossborder-decision-lab.local/ecae/schemas/state-transition.schema.json",
  "title":"Lifecycle transition event",
  "type":"object",
  "required":["schema_version","transition_id","object_id","object_version","from_status","to_status","trigger","evidence_refs","actor","occurred_at","allowed_actions","blocked_actions","rollback_target","history_hash"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "transition_id":{"type":"string","pattern":"^ECAE-TRANSITION-[A-Z0-9._:-]+$"},
    "object_id":{"type":"string","pattern":"^ECAE-[A-Z0-9][A-Z0-9._:-]{2,127}$"},
    "object_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "from_status":{"type":"string","minLength":1},
    "to_status":{"type":"string","minLength":1},
    "trigger":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "actor":{"type":"string","minLength":1},
    "occurred_at":{"type":"string","format":"date-time"},
    "allowed_actions":{"type":"array","items":{"type":"string","minLength":1}},
    "blocked_actions":{"type":"array","items":{"type":"string","minLength":1}},
    "rollback_target":{"type":["string","null"]},
    "history_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "eligibility_passed":{"type":"boolean"},
    "analysis_locked":{"type":"boolean"},
    "review_accepted":{"type":"boolean"}
  },
  "additionalProperties":false
}
