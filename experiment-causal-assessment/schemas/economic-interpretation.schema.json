{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crossborder-decision-lab.local/ecae/schemas/economic-interpretation.schema.json",
  "title":"Economic interpretation",
  "allOf":[{"$ref":"common-object.schema.json#/$defs/baseObject"}],
  "type":"object",
  "required":["causal_result_ref","currency","effect_quantity","parameter_bundle","implementation_cost","opportunity_cost","risk_cost","incremental_value_interval","break_even_effect","scenarios","economic_status","business_owner_decision_required"],
  "properties":{
    "causal_result_ref":{"type":"string","minLength":1},
    "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "effect_quantity":{"type":"object","required":["lower","point","upper","unit"],"properties":{"lower":{"type":"number"},"point":{"type":"number"},"upper":{"type":"number"},"unit":{"type":"string","minLength":1}},"additionalProperties":false},
    "parameter_bundle":{"type":"array","minItems":1,"items":{"type":"object","required":["name","value","source_ref","version","valid_until","uncertainty"],"properties":{"name":{"type":"string","minLength":1},"value":{"type":"number"},"source_ref":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"valid_until":{"type":"string","format":"date-time"},"uncertainty":{"type":"object","required":["lower","upper"],"properties":{"lower":{"type":"number"},"upper":{"type":"number"}},"additionalProperties":false}},"additionalProperties":false}},
    "implementation_cost":{"type":"number","minimum":0},
    "opportunity_cost":{"type":"number","minimum":0},
    "risk_cost":{"type":"number","minimum":0},
    "incremental_value_interval":{"type":"object","required":["lower","point","upper"],"properties":{"lower":{"type":"number"},"point":{"type":"number"},"upper":{"type":"number"}},"additionalProperties":false},
    "break_even_effect":{"type":"number"},
    "scenarios":{"type":"array","minItems":3,"items":{"type":"object","required":["name","net_value"],"properties":{"name":{"enum":["bear","base","bull"]},"net_value":{"type":"number"}},"additionalProperties":false}},
    "economic_status":{"enum":["value_supported","value_not_supported","downside_risk","precision_insufficient","parameters_unqualified"]},
    "business_owner_decision_required":{"const":true}
  },
  "unevaluatedProperties":false
}
