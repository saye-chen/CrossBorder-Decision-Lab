{
  "contract": "PLCO-AMAZON-OPS-2026.07",
  "runtime": "PLCO-2026.07",
  "platform": "Amazon",
  "maturity": "controlled_pilot",
  "principle": "The same Amazon site has different operating work, metrics and action ceilings by seller role, selling program, fulfillment mode, inventory owner, catalog owner, lifecycle and overlay.",
  "dimensions": {
    "store_identity": ["store_profile_id", "seller_account_id", "seller_id", "legal_entity_id", "marketplace_id", "marketplace_site", "selling_program", "seller_role", "fulfillment_mode", "inventory_owner", "catalog_owner", "brand_authorization_state", "ads_profile_id", "account_health_state", "tax_scope"],
    "operating_state": ["lifecycle_phase", "operating_archetype_id", "overlay_ids", "risk_state", "page_version", "offer_version", "inventory_snapshot_time", "as_of_time"],
    "work_rhythm": ["intraday", "daily", "weekly", "monthly", "event_driven"],
    "metric_scope": ["seller_account", "marketplace_site", "brand_asset_layer", "catalog", "asin", "parent_child", "seller_sku", "offer", "fulfillment", "ads_profile", "portfolio"],
    "metric_class": ["leading", "diagnostic", "outcome", "guardrail", "data_quality", "derived"],
    "action_ceiling": ["observe_only", "reconcile_and_escalate", "propose_reversible_change", "controlled_pilot_only", "blocked"]
  },
  "state_machine": [
    {"id": "prelaunch", "purpose": "identity, authorization, catalog, offer, compliance and operational readiness", "default_action_ceiling": "reconcile_and_escalate"},
    {"id": "launch", "purpose": "early buyability, traffic, conversion, inventory and service stabilization", "default_action_ceiling": "controlled_pilot_only"},
    {"id": "steady_state", "purpose": "daily exception management and mature contribution protection", "default_action_ceiling": "propose_reversible_change"},
    {"id": "growth", "purpose": "marginal scale after retail, inventory, service and measurement gates", "default_action_ceiling": "controlled_pilot_only"},
    {"id": "incident", "purpose": "contain, restore object consistency, isolate affected scope and reaccept", "default_action_ceiling": "reconcile_and_escalate"},
    {"id": "migration", "purpose": "parity, permission, offer, inventory, attribution and rollback validation", "default_action_ceiling": "observe_only"},
    {"id": "exit", "purpose": "stop, liquidate, transfer or close with residual exposure ledger", "default_action_ceiling": "reconcile_and_escalate"}
  ],
  "lifecycle_routes": {
    "prelaunch": {"workstreams": ["AMZ-OPS-01-ACCOUNT-HEALTH", "AMZ-OPS-02-CATALOG-LISTING", "AMZ-OPS-03-OFFER-BUYABILITY", "AMZ-OPS-04-INVENTORY-REPLENISHMENT", "AMZ-OPS-06-ADS-RETAIL-READINESS"], "metrics": ["M-IDENTITY-EVIDENCE-AGE", "M-PERMISSION-COVERAGE", "M-ATTRIBUTE-COMPLETENESS", "M-BUYABILITY-RATE", "M-STOCKOUT-RISK"], "action_ceiling": "reconcile_and_escalate"},
    "launch": {"workstreams": ["AMZ-OPS-02-CATALOG-LISTING", "AMZ-OPS-03-OFFER-BUYABILITY", "AMZ-OPS-04-INVENTORY-REPLENISHMENT", "AMZ-OPS-05-FULFILLMENT-SERVICE", "AMZ-OPS-06-ADS-RETAIL-READINESS"], "metrics": ["M-BUYABILITY-RATE", "M-FEATURED-OFFER-SHARE", "M-AVAILABLE-QUANTITY", "M-PROMISE-HIT-RATE", "M-AD-CVR"], "action_ceiling": "controlled_pilot_only"},
    "steady_state": {"workstreams": ["AMZ-OPS-01-ACCOUNT-HEALTH", "AMZ-OPS-03-OFFER-BUYABILITY", "AMZ-OPS-04-INVENTORY-REPLENISHMENT", "AMZ-OPS-05-FULFILLMENT-SERVICE", "AMZ-OPS-06-ADS-RETAIL-READINESS", "AMZ-OPS-08-VOC-QUALITY"], "metrics": ["M-ACCOUNT-HEALTH", "M-DAYS-OF-COVER", "M-PROMISE-HIT-RATE", "M-ATTRIBUTED-SALES", "M-RETURN-REASON-MIX"], "action_ceiling": "propose_reversible_change"},
    "growth": {"workstreams": ["AMZ-OPS-03-OFFER-BUYABILITY", "AMZ-OPS-04-INVENTORY-REPLENISHMENT", "AMZ-OPS-05-FULFILLMENT-SERVICE", "AMZ-OPS-06-ADS-RETAIL-READINESS", "AMZ-OPS-07-PROMOTION-BRAND-SURFACE", "AMZ-OPS-10-PORTFOLIO-MIGRATION"], "metrics": ["M-FEATURED-OFFER-SHARE", "M-DAYS-OF-COVER", "M-ACOS", "M-TACOS", "M-CANNIBALIZATION-SIGNAL", "M-REFUND-MATURITY"], "action_ceiling": "controlled_pilot_only"},
    "incident": {"workstreams": ["AMZ-OPS-01-ACCOUNT-HEALTH", "AMZ-OPS-02-CATALOG-LISTING", "AMZ-OPS-03-OFFER-BUYABILITY", "AMZ-OPS-05-FULFILLMENT-SERVICE", "AMZ-OPS-11-LAUNCH-CHANGE-INCIDENT"], "metrics": ["M-ACCOUNT-HEALTH", "M-SUPPRESSED-LISTING-COUNT", "M-CHANGE-FAILURE-COUNT", "M-INCIDENT-RECOVERY-AGE", "M-RESIDUAL-EXPOSURE"], "action_ceiling": "reconcile_and_escalate"},
    "migration": {"workstreams": ["AMZ-OPS-01-ACCOUNT-HEALTH", "AMZ-OPS-02-CATALOG-LISTING", "AMZ-OPS-03-OFFER-BUYABILITY", "AMZ-OPS-06-ADS-RETAIL-READINESS", "AMZ-OPS-10-PORTFOLIO-MIGRATION", "AMZ-OPS-11-LAUNCH-CHANGE-INCIDENT"], "metrics": ["M-PERMISSION-COVERAGE", "M-CONTENT-OVERWRITE-COUNT", "M-OFFER-VERSION-AGE", "M-MIGRATION-PARITY", "M-VERSION-LINEAGE-COMPLETENESS", "M-ROLLBACK-READINESS"], "action_ceiling": "observe_only"},
    "exit": {"workstreams": ["AMZ-OPS-04-INVENTORY-REPLENISHMENT", "AMZ-OPS-05-FULFILLMENT-SERVICE", "AMZ-OPS-10-PORTFOLIO-MIGRATION", "AMZ-OPS-11-LAUNCH-CHANGE-INCIDENT"], "metrics": ["M-AVAILABLE-QUANTITY", "M-UNFULFILLABLE-QUANTITY", "M-EXIT-READINESS", "M-RESIDUAL-EXPOSURE", "M-ROLLBACK-READINESS"], "action_ceiling": "reconcile_and_escalate"}
  },
  "metric_catalog": [
    {"id": "M-ACCOUNT-HEALTH", "name": "账户健康状态", "class": "guardrail", "scope": "seller_account", "definition": "当前账户可经营/受限/风险状态及证据时间", "cadence": ["intraday", "daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-POLICY-NOTICE-COUNT", "name": "政策或绩效通知数", "class": "leading", "scope": "seller_account", "definition": "指定窗口内未处理的有效通知数量", "cadence": ["intraday", "daily"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-IDENTITY-EVIDENCE-AGE", "name": "身份凭证年龄", "class": "data_quality", "scope": "seller_account", "definition": "Seller ID、主体、站点和销售项目证据距观察时点的年龄", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PERMISSION-COVERAGE", "name": "权限证据覆盖率", "class": "data_quality", "scope": "seller_account", "definition": "所需页面、品牌、广告和 Offer 权限中有授权证据的比例", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-SUPPRESSED-LISTING-COUNT", "name": "抑制 Listing 数", "class": "diagnostic", "scope": "catalog", "definition": "指定站点和时间点处于抑制/不可见状态的对象数量", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-ATTRIBUTE-COMPLETENESS", "name": "属性完整度", "class": "leading", "scope": "asin", "definition": "按当前类目要求已确认的可用属性占比", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-VARIATION-CONFLICT-COUNT", "name": "变体冲突数", "class": "diagnostic", "scope": "parent_child", "definition": "属性、产品身份、评论语境或库存绑定存在冲突的父子体数量", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-CONTENT-OVERWRITE-COUNT", "name": "内容覆盖事件数", "class": "diagnostic", "scope": "page_version", "definition": "未经当前 Owner 确认的标题、要点、图片、A+ 或属性版本变化次数", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-BRAND-ASSET-PUBLISH-STATE", "name": "品牌资产发布状态", "class": "data_quality", "scope": "brand_asset_layer", "definition": "Brand Store/A+/品牌模块的当前版本、审批和可见状态", "cadence": ["daily", "weekly", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-BUYABILITY-RATE", "name": "可购买率", "class": "outcome", "scope": "offer", "definition": "在定义窗口内满足价格、库存、配送和 Offer 条件的可购买对象比例", "cadence": ["intraday", "daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-FEATURED-OFFER-SHARE", "name": "Featured Offer 占比", "class": "outcome", "scope": "offer", "definition": "指定站点/ASIN/时间窗内当前卖家获得 Featured Offer 的份额口径", "cadence": ["intraday", "daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-OFFER-COUNT", "name": "有效卖家 Offer 数", "class": "diagnostic", "scope": "asin", "definition": "按站点、ASIN、条件和时间点去重后的有效卖家 Offer 数", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PRICE-VERSION-DRIFT", "name": "价格版本漂移", "class": "diagnostic", "scope": "offer", "definition": "批准价格版本与实际展示/成交价格版本的不一致状态", "cadence": ["intraday", "daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-OFFER-VERSION-AGE", "name": "Offer 版本年龄", "class": "data_quality", "scope": "offer", "definition": "当前 Offer 价格、库存、配送和页面快照距观察时点的年龄", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-AVAILABLE-QUANTITY", "name": "可售量", "class": "leading", "scope": "seller_sku", "definition": "当前 Seller SKU 在指定站点和履约渠道的可售数量", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-RESERVED-QUANTITY", "name": "预留量", "class": "diagnostic", "scope": "seller_sku", "definition": "当前被订单、转运或其他状态预留且不能直接作为可售的数量", "cadence": ["daily"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-INBOUND-QUANTITY", "name": "入仓量", "class": "leading", "scope": "seller_sku", "definition": "已在入仓/运输路径中但尚未成为可售库存的数量", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-UNFULFILLABLE-QUANTITY", "name": "不可履约量", "class": "guardrail", "scope": "seller_sku", "definition": "因损坏、合规、质量或其他原因不可正常履约的数量", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-DAYS-OF-COVER", "name": "库存覆盖天数", "class": "derived", "scope": "seller_sku", "definition": "按批准需求窗口和可售口径计算的库存覆盖，不以账户平均需求替代", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-STOCKOUT-RISK", "name": "缺货风险状态", "class": "guardrail", "scope": "seller_sku", "definition": "结合可售、需求、入仓、履约和观察窗给出的风险状态", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-FBA-STRANDED-QUANTITY", "name": "FBA 悬挂库存量", "class": "guardrail", "scope": "seller_sku", "definition": "已在 FBA 网络但因 Listing、Offer、合规或状态问题无法正常销售的数量", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-FBA-AGED-QUANTITY", "name": "FBA 老化库存量", "class": "guardrail", "scope": "seller_sku", "definition": "按当前站点和费用规则进入老化/长期占用区间的 FBA 数量", "cadence": ["daily", "weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-FBA-REMOVAL-QUEUE", "name": "FBA 移除队列", "class": "leading", "scope": "seller_sku", "definition": "已批准或待处理的移除、弃置、退回及其预计影响数量", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-MFN-CAPACITY-HEADROOM", "name": "MFN 履约容量余量", "class": "guardrail", "scope": "fulfillment", "definition": "在承诺时效和订单窗口内，MFN 可承接需求相对已占用容量的余量", "cadence": ["intraday", "daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-MFN-PROMISE-HIT-RATE", "name": "MFN 配送承诺命中率", "class": "guardrail", "scope": "fulfillment", "definition": "MFN 订单在明确承诺、发货和交付窗口内的命中比例", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PROMISE-HIT-RATE", "name": "配送承诺命中率", "class": "guardrail", "scope": "fulfillment", "definition": "实际交付相对于当前页面/Offer 承诺的命中口径", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-LATE-SHIPMENT-RATE", "name": "迟发率", "class": "guardrail", "scope": "fulfillment", "definition": "在明确责任方和窗口内晚于发货承诺的订单比例", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-CANCELLATION-RATE", "name": "取消率", "class": "guardrail", "scope": "fulfillment", "definition": "按取消原因、责任方和订单窗口定义的取消订单比例", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-RETURN-RATE", "name": "退货率", "class": "outcome", "scope": "offer", "definition": "按订单/发货/成熟窗口定义的退货比例", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-REFUND-RATE", "name": "退款率", "class": "outcome", "scope": "offer", "definition": "按订单、退款原因和成熟窗口定义的退款比例", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-RETURN-REASON-MIX", "name": "退货原因结构", "class": "diagnostic", "scope": "offer", "definition": "按产品、页面、履约、质量和客户预期分类的退货原因结构", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-REFUND-MATURITY", "name": "退款成熟状态", "class": "data_quality", "scope": "offer", "definition": "退款和退货窗口是否达到可以进行成熟经济判断的状态", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-CUSTOMER-CONTACT-RATE", "name": "客户联系率", "class": "diagnostic", "scope": "offer", "definition": "按订单或访问定义的客户咨询/联系比例及主题", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-AD-SPEND", "name": "广告花费", "class": "outcome", "scope": "ads_profile", "definition": "按 Ads Profile、站点、活动、日期和币种记录的实际花费", "cadence": ["daily", "weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-IMPRESSIONS", "name": "广告曝光", "class": "leading", "scope": "ads_profile", "definition": "指定广告对象和时间窗的有效曝光量", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-CLICKS", "name": "广告点击", "class": "leading", "scope": "ads_profile", "definition": "指定广告对象和时间窗的有效点击量", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-CTR", "name": "点击率", "class": "diagnostic", "scope": "ads_profile", "definition": "点击与曝光在同一广告对象和时间窗内的比值", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-AD-CVR", "name": "广告转化率", "class": "diagnostic", "scope": "ads_profile", "definition": "按定义的归因窗和购买对象计算的广告转化比值", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-ATTRIBUTED-SALES", "name": "归因销售额", "class": "outcome", "scope": "ads_profile", "definition": "按 Ads Profile、站点、ASIN、广告对象和归因窗记录的平台归因销售", "cadence": ["daily", "weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-ACOS", "name": "ACOS", "class": "diagnostic", "scope": "ads_profile", "definition": "广告花费相对于平台归因销售的效率口径，不代表增量", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-TACOS", "name": "TACOS", "class": "diagnostic", "scope": "marketplace_site", "definition": "广告花费相对于定义的总销售口径的关系，不代表增量", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-NEW-TO-BRAND-ORDERS", "name": "New-to-brand 订单", "class": "diagnostic", "scope": "ads_profile", "definition": "按平台定义、对象和归因窗记录的新客口径", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PURCHASED-ASIN-MIX", "name": "购买 ASIN 结构", "class": "diagnostic", "scope": "ads_profile", "definition": "推广 ASIN 与购买 ASIN 的分布和错配结构", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PROMOTION-ELIGIBILITY", "name": "促销资格状态", "class": "leading", "scope": "offer", "definition": "指定促销载体、站点、Offer 和时间窗的资格状态", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PROMOTION-COST", "name": "促销成本", "class": "outcome", "scope": "offer", "definition": "折扣、费用、补贴和相关活动成本的已声明口径", "cadence": ["daily", "weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PRICE-REFERENCE-STATE", "name": "参考价状态", "class": "guardrail", "scope": "offer", "definition": "活动前后参考价、价格历史和展示状态的核验结果", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-B2B-ORDER-MIX", "name": "B2B 订单结构", "class": "outcome", "scope": "marketplace_site", "definition": "企业客户订单在明确口径中的数量/销售结构", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-BRAND-SURFACE-SESSION-MIX", "name": "品牌资产流量结构", "class": "diagnostic", "scope": "brand_asset_layer", "definition": "Brand Store/A+ 等品牌资产入口的流量结构", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-RATING-DISTRIBUTION", "name": "评分分布", "class": "outcome", "scope": "asin", "definition": "按 ASIN、变体、时间窗和对象身份拆分的评分分布", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-NEGATIVE-VOC-THEME-RATE", "name": "负面 VOC 主题率", "class": "diagnostic", "scope": "offer", "definition": "按对象和主题分类的负面反馈占比", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-QUALITY-INCIDENT-COUNT", "name": "质量事件数", "class": "guardrail", "scope": "asin", "definition": "指定窗口内需升级处理的质量、安全或一致性事件数", "cadence": ["daily", "event_driven"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PO-OPEN-QTY", "name": "未结采购订单量", "class": "leading", "scope": "seller_account", "definition": "Vendor 关系下仍未关闭的采购订单数量/单位", "cadence": ["daily", "weekly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PO-FILL-RATE", "name": "采购订单填充率", "class": "outcome", "scope": "seller_account", "definition": "确认/交付数量相对于采购订单需求的已声明口径", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-PO-ON_TIME-RATE", "name": "采购订单准时率", "class": "guardrail", "scope": "fulfillment", "definition": "Vendor 采购订单在定义承诺窗口内完成的比例", "cadence": ["weekly", "monthly"], "missing_semantics": "unknown_not_zero"},
    {"id": "M-WHOLESALE-PRICE-VERSION", "name": "批发价格版本", "class": "data_quality", "scope": "seller_account", "definition": "Vendor 批发价格、有效期和账单使用版本是否一致", "cadence": ["weekly", "monthly", "event_driven"], "missing_semantics": "unknown_not_zero"},
