{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/pipm/input-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_id", "object_id", "object_version", "country", "platform", "product_lifecycle_stage", "decision_question", "input_level", "fields", "source_ids", "as_of_time"],
  "properties": {
    "input_id": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "object_version": {"type": "string", "minLength": 1},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "platform": {"type": "string", "minLength": 1},
    "product_lifecycle_stage": {"enum": ["PLC0", "PLC1", "PLC2", "PLC3", "PLC4", "PLC5", "PLC6", "PLC7", "PLC8"]},
    "decision_question": {"type": "string", "minLength": 1},
    "input_level": {"enum": ["M0", "M1", "M2", "M3"]},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "value_state", "source_id"],
        "properties": {
          "field_id": {"type": "string", "minLength": 1},
          "value_state": {"enum": ["observed", "missing", "unavailable", "not_applicable", "not_yet_observed", "withheld", "invalid", "observed_zero"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "source_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "as_of_time": {"type": "string", "format": "date-time"}
  }
}
