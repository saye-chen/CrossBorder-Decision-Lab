{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/pipm/cross-domain-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "message_id", "message_version", "correlation_id", "idempotency_key", "sender", "receiver", "object_ref", "scope", "payload_type", "status", "claims", "claim_acceptance", "changed_fields", "recomputation", "allowed_uses", "forbidden_uses", "external_write", "validity", "lineage"],
  "properties": {
    "contract": {"const": "PIPM-XDOMAIN-2026.01"},
    "message_id": {"type": "string", "minLength": 1},
    "message_version": {"const": "PIPM-XMSG-2026.01"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "sender": {"enum": ["product-innovation-product-management", "pricing-profit-finance-cashflow-decision"]},
    "receiver": {"enum": ["product-innovation-product-management", "pricing-profit-finance-cashflow-decision"]},
    "object_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_version", "object_type"],
      "properties": {"object_id": {"type": "string", "minLength": 1}, "object_version": {"type": "string", "minLength": 1}, "object_type": {"type": "string", "minLength": 1}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["country", "platform", "currency", "tax_basis", "as_of_time"],
      "properties": {"country": {"type": "string", "minLength": 2}, "platform": {"type": "string", "minLength": 1}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "tax_basis": {"type": "string", "minLength": 1}, "as_of_time": {"type": "string", "format": "date-time"}}
    },
    "payload_type": {"enum": ["product_change", "economic_constraint", "recompute_request", "recompute_result", "acceptance", "rejection"]},
    "status": {"enum": ["proposed", "blocked", "inconclusive", "superseded"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "field", "value"],
        "properties": {"claim_id": {"type": "string"}, "field": {"type": "string"}, "value": {}}
      }
    },
    "claim_acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "decision"],
        "properties": {"claim_id": {"type": "string"}, "decision": {"enum": ["accepted", "rejected", "blocked"]}, "reason": {"type": ["string", "null"]}}
      }
    },
    "changed_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recomputation": {"$ref": "recomputation-impact.schema.json"},
    "allowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "external_write": {"const": false},
    "validity": {"type": "object", "required": ["valid_from", "recorded_at"], "properties": {"valid_from": {"type": "string", "format": "date-time"}, "valid_to": {"type": ["string", "null"], "format": "date-time"}, "recorded_at": {"type": "string", "format": "date-time"}}},
    "lineage": {"type": "object", "required": ["input_hash", "parameter_snapshot_id", "runtime_version"], "properties": {"input_hash": {"type": "string", "pattern": "^sha256:"}, "parameter_snapshot_id": {"type": "string"}, "runtime_version": {"enum": ["PIPM-2026.01", "PPFC-2026.01"]}, "supersedes": {"type": ["string", "null"]}}}
  }
}
