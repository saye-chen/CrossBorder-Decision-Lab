{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/pipm/professional-opinion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["opinion_id", "evidence_type", "subject_role", "credential_scope", "jurisdictions", "conflict_of_interest", "basis_refs", "issued_at", "verified_at", "expires_at", "object_ref", "opinion_state", "claim_upgrade_allowed", "limitations"],
  "properties": {
    "opinion_id": {"type": "string"},
    "evidence_type": {"const": "professional_opinion"},
    "subject_role": {"type": "string"},
    "credential_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "jurisdictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "conflict_of_interest": {"enum": ["none", "disclosed_and_mitigated", "undisclosed"]},
    "basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "object_ref": {"type": "object", "required": ["object_id", "object_version"], "properties": {"object_id": {"type": "string"}, "object_version": {"type": "string"}}},
    "opinion_state": {"enum": ["proposed", "accepted_as_evidence", "rejected", "expired"]},
    "claim_upgrade_allowed": {"const": false},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
