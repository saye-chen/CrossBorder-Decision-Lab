{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ltma/formal-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "migration_id", "temporary_contract", "formal_contract", "snapshot_id", "object_ref", "business_time", "mappings", "consumer_acceptance", "legacy_read_preserved", "legacy_state_preserved", "action_ceiling_comparison", "rollback_triggers", "rollback_status"],
  "properties": {
    "contract": {"const": "D05-MIGRATION-DRAFT-1"},
    "migration_id": {"type": "string"},
    "temporary_contract": {"type": "string"},
    "formal_contract": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "object_ref": {"type": "string"},
    "business_time": {"type": "string", "format": "date-time"},
    "mappings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_field", "target_field", "transform", "classification", "criticality", "validator", "consumer", "rollback"], "properties": {"source_field": {"type": "string"}, "target_field": {"type": ["string", "null"]}, "transform": {"type": "string"}, "classification": {"enum": ["lossless", "lossy", "unmapped", "conflict", "expired"]}, "criticality": {"enum": ["noncritical", "major", "safety_critical"]}, "validator": {"type": "string"}, "consumer": {"type": "string"}, "rollback": {"type": "string"}}}},
    "consumer_acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["consumer", "status"], "properties": {"consumer": {"type": "string"}, "status": {"enum": ["accepted", "rejected", "partially_accepted", "pending"]}}}},
    "legacy_read_preserved": {"const": true},
    "legacy_state_preserved": {"const": true},
    "action_ceiling_comparison": {"enum": ["same", "lower", "higher", "incomparable"]},
    "rollback_triggers": {"type": "array", "items": {"type": "string"}},
    "rollback_status": {"enum": ["not_required", "ready", "triggered", "completed"]}
  }
}
