{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ltma/dynamic-rule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "rule_id", "issuer", "source_ref", "source_family", "rule_version", "jurisdictions", "scope", "effective_at", "verified_at", "expires_at", "supersedes", "refresh_trigger", "content_hash", "state"],
  "properties": {
    "contract": {"const": "D05-RULE-DRAFT-1"},
    "rule_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "source_family": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "jurisdictions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "object", "required": ["object_types", "uses", "platforms"], "properties": {"object_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "uses": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "effective_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "refresh_trigger": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["current", "scheduled", "expired", "superseded", "conflicted", "unavailable"]}
  }
}
