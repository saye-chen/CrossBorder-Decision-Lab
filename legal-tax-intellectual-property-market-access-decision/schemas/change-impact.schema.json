{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ltma/change-impact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "change_id", "root_object_ref", "changed_fields", "previous_version", "new_version", "direct_dependencies", "affected_claims", "affected_decisions", "affected_actions", "preserved_results", "recompute_scope", "history_preserved"],
  "properties": {
    "contract": {"const": "D05-IMPACT-DRAFT-1"},
    "change_id": {"type": "string"},
    "root_object_ref": {"type": "string"},
    "changed_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "previous_version": {"type": "string"},
    "new_version": {"type": "string"},
    "direct_dependencies": {"type": "array", "items": {"type": "string"}},
    "affected_claims": {"type": "array", "items": {"type": "string"}},
    "affected_decisions": {"type": "array", "items": {"type": "string"}},
    "affected_actions": {"type": "array", "items": {"type": "string"}},
    "preserved_results": {"type": "array", "items": {"type": "string"}},
    "recompute_scope": {"type": "array", "items": {"type": "string"}},
    "history_preserved": {"const": true}
  }
}
