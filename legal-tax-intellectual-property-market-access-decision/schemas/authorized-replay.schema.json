{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "case_id",
        "authorization_ref",
        "deidentified",
        "object_hash",
        "jurisdictions",
        "topics",
        "input_hash",
        "output_hash",
        "observed_outcome_ref",
        "independent_reviewer_ref",
        "review_decision",
        "signed_at",
        "synthetic"
    ],
    "properties": {
        "case_id": {
            "type": "string",
            "minLength": 1
        },
        "authorization_ref": {
            "type": "string",
            "minLength": 1
        },
        "deidentified": {
            "const": true
        },
        "object_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "jurisdictions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 2
            }
        },
        "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "input_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "output_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "observed_outcome_ref": {
            "type": "string",
            "minLength": 1
        },
        "independent_reviewer_ref": {
            "type": "string",
            "minLength": 1
        },
        "review_decision": {
            "enum": [
                "approved",
                "changes_required",
                "rejected"
            ]
        },
        "signed_at": {
            "type": "string",
            "format": "date-time"
        },
        "synthetic": {
            "const": false
        }
    }
}
