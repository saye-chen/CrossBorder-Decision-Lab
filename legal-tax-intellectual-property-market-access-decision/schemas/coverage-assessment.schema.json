{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ltma/coverage-assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "assessment_id", "assessment_type", "object_ref", "required_dimensions", "matched_dimensions", "mismatched_dimensions", "unknown_dimensions", "evidence_refs", "result", "professional_review_required", "allowed_uses", "blocked_actions"],
  "properties": {
    "contract": {"const": "D05-COVERAGE-DRAFT-1"},
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_type": {"enum": ["classification", "certificate", "test_report", "label", "claim", "ip_screening", "tax_customs", "platform_access"]},
    "object_ref": {"type": "string", "minLength": 1},
    "required_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "matched_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "mismatched_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unknown_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["covered", "partially_covered", "not_covered", "inconclusive", "review_required"]},
    "professional_review_required": {"type": "boolean"},
    "allowed_uses": {"type": "array", "items": {"type": "string"}},
    "blocked_actions": {"type": "array", "items": {"type": "string"}}
  }
}
