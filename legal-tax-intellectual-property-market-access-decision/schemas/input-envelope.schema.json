{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ltma/input-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request_id", "decision_question", "proposed_action", "object_ref", "product_facts", "scope_ref", "use_ref", "claims", "evidence_refs", "requester_authority", "as_of_time", "external_write"],
  "properties": {
    "contract": {"const": "D05-INPUT-DRAFT-1"},
    "request_id": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "proposed_action": {"type": "string", "minLength": 1},
    "object_ref": {"type": "string", "minLength": 1},
    "product_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_product", "materials", "energy", "connectivity", "packaging"],
      "properties": {
        "intended_product": {"type": "string", "minLength": 1},
        "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ingredients": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "energy": {"type": ["string", "null"]},
        "connectivity": {"type": ["string", "null"]},
        "packaging": {"type": "string", "minLength": 1}
      }
    },
    "scope_ref": {"type": "string", "minLength": 1},
    "use_ref": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "text", "language", "medium"], "properties": {"claim_id": {"type": "string"}, "text": {"type": "string"}, "language": {"type": "string"}, "medium": {"type": "string"}}}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requester_authority": {"type": "object", "required": ["requester", "allowed_uses"], "properties": {"requester": {"type": "string", "minLength": 1}, "allowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "as_of_time": {"type": "string", "format": "date-time"},
    "external_write": {"const": false}
  }
}
