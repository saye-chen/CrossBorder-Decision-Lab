{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ltma/state-machine.schema.json",
  "title": "D05 Lifecycle State Machine",
  "description": "Formal lifecycle states and permitted transitions for D05 market access decisions. Blueprint §4.",
  "lifecycle_phases": ["sense → define → qualify → launch → learn → recover → exit"],
  "states": {
    "intake": {"phase": "sense", "description": "已登记但尚未完成最小输入检查", "terminal": false},
    "screening": {"phase": "define", "description": "进行风险与适用性初筛", "terminal": false},
    "evidence_required": {"phase": "qualify", "description": "需要补证或专业复核", "terminal": false},
    "professional_review": {"phase": "qualify", "description": "等待或验证适格专业意见", "terminal": false},
    "conditionally_cleared": {"phase": "launch", "description": "仅在明确条件、对象和时间窗内可继续", "terminal": false},
    "cleared_for_named_use": {"phase": "launch", "description": "只对列明用途和范围通过商业Gate", "terminal": false},
    "blocked": {"phase": "recover", "description": "不可补偿红线或关键证据缺失", "terminal": false},
    "suspended": {"phase": "recover", "description": "曾有效结论因变化或事故被冻结", "terminal": false},
    "remediation": {"phase": "recover", "description": "整改与重新验证中", "terminal": false},
    "withdrawn": {"phase": "exit", "description": "主动撤回", "terminal": false},
    "expired": {"phase": "exit", "description": "规则、证书或意见超过有效期", "terminal": false},
    "superseded": {"phase": "exit", "description": "被新版本替代", "terminal": false},
    "closed": {"phase": "exit", "description": "退出完成且保留记录", "terminal": true}
  },
  "transitions": {
    "null → intake": {"guard": "object registered with minimum identity dimensions", "requires_external_write": false},
    "intake → screening": {"guard": "minimum input check passed", "requires_external_write": false},
    "intake → evidence_required": {"guard": "input check reveals evidence gap at intake", "requires_external_write": false},
    "intake → withdrawn": {"guard": "object withdrawn before screening", "requires_external_write": false},
    "screening → evidence_required": {"guard": "screening identifies evidence gap", "requires_external_write": false},
    "screening → professional_review": {"guard": "screening identifies need for qualified professional opinion", "requires_external_write": false},
    "screening → conditionally_cleared": {"guard": "low-risk with named conditions only", "requires_external_write": false},
    "screening → blocked": {"guard": "non-compensable redline identified", "requires_external_write": false},
    "screening → withdrawn": {"guard": "object withdrawn after screening", "requires_external_write": false},
    "evidence_required → screening": {"guard": "evidence completed, re-enter screening", "requires_external_write": false},
    "evidence_required → professional_review": {"guard": "evidence sufficient, escalate to professional", "requires_external_write": false},
    "evidence_required → blocked": {"guard": "evidence gap is non-compensable", "requires_external_write": false},
    "evidence_required → withdrawn": {"guard": "object withdrawn during evidence collection", "requires_external_write": false},
    "evidence_required → expired": {"guard": "evidence deadline passed without completion", "requires_external_write": false},
    "professional_review → evidence_required": {"guard": "professional opinion reveals new evidence gap", "requires_external_write": false},
    "professional_review → conditionally_cleared": {"guard": "professional opinion supports conditional clearance", "requires_external_write": false},
    "professional_review → blocked": {"guard": "professional opinion identifies non-compensable risk", "requires_external_write": false},
    "professional_review → withdrawn": {"guard": "object withdrawn during professional review", "requires_external_write": false},
    "professional_review → expired": {"guard": "professional opinion deadline passed", "requires_external_write": false},
    "conditionally_cleared → cleared_for_named_use": {"guard": "all named conditions verified and satisfied", "requires_external_write": false},
    "conditionally_cleared → evidence_required": {"guard": "condition evidence invalidated", "requires_external_write": false},
    "conditionally_cleared → blocked": {"guard": "condition violated with non-compensable impact", "requires_external_write": false},
    "conditionally_cleared → suspended": {"guard": "dynamic fact change freezes conditional clearance", "requires_external_write": false},
    "conditionally_cleared → expired": {"guard": "conditional clearance time window passed", "requires_external_write": false},
    "cleared_for_named_use → suspended": {"guard": "rule change, incident or dynamic fact change freezes clearance", "requires_external_write": false},
    "cleared_for_named_use → remediation": {"guard": "corrective action initiated without full suspension", "requires_external_write": false},
    "cleared_for_named_use → expired": {"guard": "clearance validity period ended", "requires_external_write": false},
    "cleared_for_named_use → superseded": {"guard": "newer decision version replaces this one", "requires_external_write": false},
    "cleared_for_named_use → closed": {"guard": "object exits with completed record", "requires_external_write": false},
    "blocked → remediation": {"guard": "remediation plan accepted, evidence collection begins", "requires_external_write": false},
    "blocked → withdrawn": {"guard": "object withdrawn while blocked", "requires_external_write": false},
    "blocked → closed": {"guard": "blocked object permanently closed", "requires_external_write": false},
    "suspended → remediation": {"guard": "suspension investigation complete, remediation begins", "requires_external_write": false},
    "suspended → withdrawn": {"guard": "suspended object withdrawn", "requires_external_write": false},
    "suspended → closed": {"guard": "suspended object permanently closed", "requires_external_write": false},
    "remediation → evidence_required": {"guard": "remediation reveals new evidence gap", "requires_external_write": false},
    "remediation → professional_review": {"guard": "remediation complete, professional re-verification needed", "requires_external_write": false},
    "remediation → conditionally_cleared": {"guard": "remediation verified with conditions", "requires_external_write": false},
    "remediation → blocked": {"guard": "remediation fails, non-compensable risk remains", "requires_external_write": false},
    "remediation → withdrawn": {"guard": "object withdrawn during remediation", "requires_external_write": false},
    "withdrawn → closed": {"guard": "withdrawn object record closed", "requires_external_write": false},
    "expired → evidence_required": {"guard": "renewed evidence collection after expiry", "requires_external_write": false},
    "expired → professional_review": {"guard": "renewed professional review after expiry", "requires_external_write": false},
    "expired → remediation": {"guard": "remediation initiated after expiry", "requires_external_write": false},
    "expired → closed": {"guard": "expired object record closed", "requires_external_write": false},
    "superseded → closed": {"guard": "superseded object record closed", "requires_external_write": false}
  },
  "invariants": [
    "cleared states are never universal validity claims; they carry object, jurisdiction, platform, use, evidence, validity window, limitations and dependency versions",
    "blocked, suspended and expired states require explicit blocked_actions enumeration",
    "allowed_actions and blocked_actions must not overlap",
    "closed is the only terminal state; no transitions out of closed",
    "controlled staging (conditionality_cleared) must never emit cleared_for_named_use directly",
    "any identity dimension change (subject, product, scope, use, claim, rule, opinion, certificate) requires a new object version, not silent migration"
  ]
}
