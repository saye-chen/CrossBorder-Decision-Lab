{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/lifd/ecae_inventory_receipt.schema.json",
  "title": "LIFD consumer-side receipt for an ECAE incremental inventory input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_version",
    "receipt_id",
    "domain_id",
    "migration_id",
    "contract_version",
    "handoff_ref",
    "handoff_content_hash",
    "causal_evidence_grade",
    "claim_ceiling",
    "intended_use",
    "decision",
    "effective_use",
    "incremental_value_state",
    "incremental_contribution",
    "ranking_use_allowed",
    "causal_wording_allowed",
    "reasons",
    "accepted_by_consumer_owner",
    "consumer_owner_acceptance_ref",
    "business_owner_decision_required",
    "inventory_decision_owner",
    "external_write",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "runtime_version": {
      "const": "LIFD-2026.07"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^LIFD-ECAE-RECEIPT-[a-f0-9]{16}$"
    },
    "domain_id": {
      "const": "D07"
    },
    "migration_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "handoff_ref": {
      "type": "string",
      "minLength": 1
    },
    "handoff_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "causal_evidence_grade": {
      "enum": [
        "CE0",
        "CE1",
        "CE2",
        "CE3",
        "CE4",
        "CE5"
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "enum": [
        "incremental_demand_input",
        "high_stakes_inventory_support"
      ]
    },
    "decision": {
      "enum": [
        "accept",
        "hold_pending_consumer_acceptance",
        "degrade",
        "reject",
        "request_recompute"
      ]
    },
    "effective_use": {
      "type": "string",
      "minLength": 1
    },
    "incremental_value_state": {
      "enum": [
        "qualified",
        "unknown"
      ]
    },
    "incremental_contribution": {
      "type": [
        "number",
        "null"
      ]
    },
    "ranking_use_allowed": {
      "type": "boolean"
    },
    "causal_wording_allowed": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "accepted_by_consumer_owner": {
      "type": "boolean"
    },
    "consumer_owner_acceptance_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_owner_decision_required": {
      "const": true
    },
    "inventory_decision_owner": {
      "const": "LIFD"
    },
    "external_write": {
      "const": false
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
