{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ppfc/professional-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "report_version", "report_type", "decision_id", "decision_version", "status", "is_current", "object_ref", "scope", "as_of_time", "current_conclusion", "history_refs", "evidence", "counterevidence", "conflicts", "missing_data", "baseline", "candidates", "calculations", "parameter_snapshot_id", "economics", "metrics", "sensitivity", "attribution_incrementality", "actions", "success_conditions", "stop_conditions", "rollback_conditions", "exit_conditions", "allowed_uses", "forbidden_uses", "lineage"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "report_version": {"type": "string", "pattern": "^PPFC-REPORT-20[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"},
    "report_type": {"enum": ["decision_card", "pricing_memo", "unit_economics_report", "cashflow_plan", "financial_risk_brief", "promotion_economics_review", "parameter_change_impact", "freight_cost_breakdown"]},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "proposed", "validated", "accepted", "executed", "observed", "closed", "inconclusive", "blocked", "rejected", "expired", "rolled_back", "retired"]},
    "is_current": {"type": "boolean"},
    "object_ref": {"type": "object"},
    "scope": {"type": "object"},
    "as_of_time": {"type": "string", "format": "date-time"},
    "current_conclusion": {"type": "string", "minLength": 1},
    "history_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterevidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "missing_data": {"type": "array", "items": {"type": "string"}},
    "baseline": {"type": "object"},
    "candidates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "calculations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "parameter_snapshot_id": {"type": "string", "minLength": 1},
    "economics": {"type": "object"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "sensitivity": {"type": "object"},
    "attribution_incrementality": {"type": "object"},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "success_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exit_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_hash", "output_hash", "model_version", "runtime_version"],
      "properties": {"input_hash": {"type": "string", "pattern": "^sha256:"}, "output_hash": {"type": "string", "pattern": "^sha256:"}, "model_version": {"type": "string", "minLength": 1}, "runtime_version": {"const": "PPFC-2026.01"}, "supersedes": {"type": ["string", "null"]}}
    }
  }
}
