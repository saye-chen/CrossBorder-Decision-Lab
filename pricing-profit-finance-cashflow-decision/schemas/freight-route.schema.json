{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ppfc/freight-route.schema.json",
  "title": "PPFC Dynamic Freight Route",
  "type": "object",
  "required": ["currency", "segments"],
  "properties": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "transport_mode", "eligible", "actual_weight", "volume", "volumetric_divisor", "weight_rounding_increment", "base_charge", "minimum_charge", "tiers", "surcharges", "tax_rate", "currency"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "transport_mode": {"enum": ["land", "sea", "air", "rail", "warehouse", "last_mile", "reverse"]},
          "eligible": {"type": "boolean"},
          "actual_weight": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "volume": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "volumetric_divisor": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "weight_rounding_increment": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "base_charge": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "minimum_charge": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["from_inclusive", "to_exclusive", "rate_per_weight"],
              "properties": {
                "from_inclusive": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "to_exclusive": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "rate_per_weight": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
              },
              "additionalProperties": false
            }
          },
          "surcharges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "value", "applies", "mutual_exclusion_group"],
              "properties": {
                "type": {"enum": ["amount", "rate_on_base_and_tier"]},
                "value": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "applies": {"type": "boolean"},
                "mutual_exclusion_group": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "tax_rate": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
