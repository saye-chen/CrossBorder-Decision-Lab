{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ppfc/decision-state.schema.json",
  "title": "PPFC Decision State",
  "type": "object",
  "required": ["decision_id", "decision_type", "version", "subject_id", "lifecycle_stage", "status", "action_ceiling", "as_of_time", "parameter_snapshot_ids", "evidence_ids", "state_events", "current_conclusion", "allowed_actions", "blocked_actions", "recompute_triggers"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "decision_type": {"enum": ["price_architecture", "new_product_price", "reprice", "promotion_economics", "unit_economics", "break_even", "budget_constraint", "cashflow", "financial_risk", "clearance_exit"]},
    "version": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "lifecycle_stage": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8"]},
    "status": {"enum": ["draft", "proposed", "validated", "accepted", "executed", "observed", "closed", "inconclusive", "blocked", "rejected", "expired", "superseded", "rolled_back", "retired"]},
    "action_ceiling": {"enum": ["evidence_request_only", "hypothesis_only", "scenario_comparison", "recommendation", "submit_for_acceptance", "manual_execution_ready", "observe_only", "history_only"]},
    "as_of_time": {"type": "string", "format": "date-time"},
    "parameter_snapshot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "state_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "from_status", "to_status", "occurred_at", "actor", "reason"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "from_status": {"type": ["string", "null"]},
          "to_status": {"type": "string", "minLength": 1},
          "occurred_at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "current_conclusion": {"type": "string", "minLength": 1},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "recompute_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["price", "cost", "fee", "tax", "fx", "product_spec", "packaging", "inventory", "refund", "route", "evidence", "model_contract", "parameter_expiry"]}},
    "previous_decision_version": {"type": ["string", "null"]},
    "superseded_by_version": {"type": ["string", "null"]},
    "rollback_to_version": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
