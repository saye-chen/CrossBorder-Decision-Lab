{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ppfc/economic-subject.schema.json",
  "title": "PPFC Economic Subject",
  "type": "object",
  "required": ["subject_id", "subject_type", "version", "scope", "as_of_time", "currency", "tax_basis", "quantity_basis", "source_ids", "recorded_at"],
  "properties": {
    "subject_id": {"type": "string", "minLength": 1},
    "subject_type": {"enum": ["enterprise", "portfolio", "market_platform", "category", "product", "sku", "batch", "offer", "campaign", "order", "order_line", "customer", "cohort", "contract", "route"]},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "parent_subject_id": {"type": ["string", "null"], "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["country_code"],
      "properties": {
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "platform_id": {"type": ["string", "null"]},
        "store_id": {"type": ["string", "null"]},
        "channel_id": {"type": ["string", "null"]},
        "sku_id": {"type": ["string", "null"]},
        "batch_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "as_of_time": {"type": "string", "format": "date-time"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "tax_basis": {"enum": ["tax_inclusive", "tax_exclusive", "pass_through_excluded", "unknown"]},
    "quantity_basis": {"type": "string", "minLength": 1},
    "unit_system": {"enum": ["metric", "imperial", "mixed", "not_applicable"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_version": {"type": ["string", "null"]},
    "supersedes_version": {"type": ["string", "null"]},
    "retirement_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
