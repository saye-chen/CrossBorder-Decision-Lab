{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ppfc/localization-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["migration_id", "source_contract", "target_contract", "state", "field_mappings", "dual_run", "differences", "acceptance", "rollback", "lineage"],
  "properties": {
    "migration_id": {"type": "string", "minLength": 1},
    "source_contract": {"const": "F02-temporary-localization-contract-v1"},
    "target_contract": {"type": "string", "minLength": 1},
    "state": {"enum": ["shadow", "dual_run", "cutover_ready", "cutover", "rolled_back", "retired", "blocked"]},
    "field_mappings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source_field", "target_field", "transform", "loss"],
        "properties": {"source_field": {"type": "string"}, "target_field": {"type": "string"}, "transform": {"type": "string"}, "loss": {"enum": ["none", "explainable", "material", "unmapped"]}}
      }
    },
    "dual_run": {
      "type": "object", "additionalProperties": false, "required": ["same_input_hash", "source_result_hash", "target_result_hash"],
      "properties": {"same_input_hash": {"type": "string", "pattern": "^sha256:"}, "source_result_hash": {"type": "string", "pattern": "^sha256:"}, "target_result_hash": {"type": "string", "pattern": "^sha256:"}}
    },
    "differences": {"type": "array", "items": {"type": "object"}},
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["accepted", "accepted_by", "accepted_at"],
      "properties": {"accepted": {"type": "boolean"}, "accepted_by": {"type": ["string", "null"]}, "accepted_at": {"type": ["string", "null"], "format": "date-time"}}
    },
    "rollback": {
      "type": "object", "additionalProperties": false, "required": ["supported", "deadline", "source_readable"],
      "properties": {"supported": {"const": true}, "deadline": {"type": "string", "format": "date-time"}, "source_readable": {"const": true}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["input_hash", "runtime_version"],
      "properties": {"input_hash": {"type": "string", "pattern": "^sha256:"}, "runtime_version": {"const": "PPFC-2026.07"}}
    }
  }
}
