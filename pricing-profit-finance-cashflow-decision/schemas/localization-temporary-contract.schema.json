{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ppfc/localization-temporary-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "localization_id", "version", "country_code", "platform_id", "currency_code", "fx", "tax", "unit_system", "time_zone", "settlement_calendar", "dynamic_rule", "localization_status", "evidence_grade", "action_ceiling", "validity", "lineage", "external_write"],
  "properties": {
    "contract": {"const": "F02-temporary-localization-contract-v1"},
    "localization_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^F02-TEMP-20[0-9]{2}\\.[0-9]{2}$"},
    "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "platform_id": {"type": "string", "minLength": 1},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "fx": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "rate", "base_currency", "quote_currency", "verified_at", "valid_until"],
      "properties": {
        "source": {"type": "string", "minLength": 1}, "rate": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "verified_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "tax": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "inclusive", "source", "verified_at", "valid_until"],
      "properties": {
        "basis": {"enum": ["tax_inclusive_revenue", "tax_exclusive_revenue", "pass_through", "unknown"]},
        "inclusive": {"type": "boolean"}, "source": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "unit_system": {"enum": ["metric", "imperial", "mixed"]},
    "time_zone": {"type": "string", "minLength": 1},
    "settlement_calendar": {
      "type": "object", "additionalProperties": false, "required": ["calendar_id", "settlement_days", "cutoff_time"],
      "properties": {"calendar_id": {"type": "string", "minLength": 1}, "settlement_days": {"type": "integer", "minimum": 0}, "cutoff_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}
    },
    "dynamic_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "effective_at", "expires_at", "refresh_trigger"],
      "properties": {
        "source": {"type": "string", "minLength": 1}, "effective_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "refresh_trigger": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["source_update", "expiry", "contract_change", "fee_schedule_change", "fx_threshold", "tax_basis_change", "settlement_calendar_change", "manual_review"]}},
        "supersedes_rule_id": {"type": ["string", "null"]}, "rollback_rule_id": {"type": ["string", "null"]}
      }
    },
    "localization_status": {"enum": ["proposed", "validated", "inconclusive", "blocked", "expired", "superseded", "retired"]},
    "evidence_grade": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
    "action_ceiling": {"enum": ["analysis_only", "controlled_test", "reversible_action", "human_approved_execution"]},
    "validity": {
      "type": "object", "additionalProperties": false, "required": ["valid_from", "valid_until", "recorded_at"],
      "properties": {"valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}, "recorded_at": {"type": "string", "format": "date-time"}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["input_hash", "runtime_version", "evidence_ids"],
      "properties": {"input_hash": {"type": "string", "pattern": "^sha256:"}, "runtime_version": {"const": "PPFC-2026.07"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}
    },
    "external_write": {"const": false}
  }
}
