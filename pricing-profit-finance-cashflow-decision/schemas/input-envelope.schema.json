{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ppfc/input-envelope.schema.json",
  "title": "PPFC Input Envelope",
  "type": "object",
  "required": ["input_id", "subject_id", "subject_version", "decision_question", "as_of_time", "accounting_view", "currency", "tax_basis", "quantity_unit", "source_ids", "evidence_ids", "missing_fields", "assumptions", "input_hash"],
  "properties": {
    "input_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_version": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "as_of_time": {"type": "string", "format": "date-time"},
    "window_start": {"type": ["string", "null"], "format": "date-time"},
    "window_end": {"type": ["string", "null"], "format": "date-time"},
    "accounting_view": {"enum": ["unit", "order", "test", "channel", "batch", "period", "inventory", "cohort", "capital"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "tax_basis": {"enum": ["tax_inclusive", "tax_exclusive", "pass_through_excluded", "unknown"]},
    "quantity_unit": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "missing_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
