{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder.local/ppfc/exception-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["exception_id", "exception_type", "severity", "status", "affected_objects", "failed_fields", "valid_retained_outputs", "action_ceiling", "blocked_actions", "recovery_owner", "recovery_requirements", "evidence_ids", "occurred_at", "lineage"],
  "properties": {
    "exception_id": {"type": "string", "minLength": 1},
    "exception_type": {"enum": ["IDENTITY_VERSION", "UNIT_CURRENCY_TAX_TIME", "MISSING_PARAMETER", "EXPIRED_PARAMETER", "AMBIGUOUS_RULE", "RECONCILIATION", "MODEL_ROUTE", "CASH_REDLINE", "ATTRIBUTION_INCREMENTALITY", "TOOL_FAILURE", "PARTIAL_DOMAIN_FAILURE", "AUTHORITY_VIOLATION"]},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["open", "contained", "resolved", "accepted_risk", "superseded"]},
    "affected_objects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failed_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "valid_retained_outputs": {"type": "array", "items": {"type": "string"}},
    "action_ceiling": {"enum": ["analysis_only", "controlled_test", "reversible_action", "human_approved_execution"]},
    "blocked_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recovery_owner": {"type": "string", "minLength": 1},
    "recovery_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "occurred_at": {"type": "string", "format": "date-time"},
    "resolve_by": {"type": ["string", "null"], "format": "date-time"},
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["input_hash", "runtime_version"],
      "properties": {"input_hash": {"type": "string", "pattern": "^sha256:"}, "runtime_version": {"const": "PPFC-2026.07"}, "supersedes": {"type": ["string", "null"]}}
    }
  }
}
