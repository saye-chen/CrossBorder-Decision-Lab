{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossborder-decision-lab.local/ppfc/evidence-record.schema.json",
  "title": "PPFC Evidence Record",
  "type": "object",
  "required": ["evidence_id", "subject_id", "evidence_grade", "source_type", "source_ref", "observed_at", "recorded_at", "processing_status", "fingerprint", "allowed_uses", "forbidden_uses"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "evidence_grade": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]},
    "source_type": {"enum": ["missing", "user_assertion", "approved_assumption", "observed_public", "official_rule", "authorized_first_party", "authorized_third_party", "deterministic_calculation", "platform_attribution", "prediction", "causal_evidence", "historical_replay"]},
    "source_ref": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "processing_status": {"enum": ["raw", "normalized", "verified", "conflicted", "stale", "invalid"]},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fact_description", "scenario_input", "current_object_calculation", "deterministic_result", "attribution_description", "prediction", "incremental_economics", "historical_calibration"]}},
    "forbidden_uses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conflict_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
