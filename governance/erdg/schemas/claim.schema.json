{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erdg/claim/1.0.0",
  "type": "object",
  "required": ["claim_id", "owner_domain", "object_id", "state", "grade", "evidence_ids", "allowed_uses", "forbidden_uses"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "owner_domain": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["hypothesis", "proposed", "validated", "rejected", "blocked", "inconclusive", "superseded"]},
    "grade": {"enum": ["descriptive", "associational", "predictive", "attributed", "causal", "decision_grade"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_uses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "forbidden_uses": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
