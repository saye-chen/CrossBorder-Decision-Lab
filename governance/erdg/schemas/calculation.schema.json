{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "erdg/calculation/1.0.0",
    "type": "object",
    "required": [
        "calculation_id",
        "calculator",
        "calculator_version",
        "input_hash",
        "output_hash",
        "status"
    ],
    "properties": {
        "calculation_id": {
            "type": "string",
            "minLength": 1
        },
        "calculator": {
            "type": "string",
            "minLength": 1
        },
        "calculator_version": {
            "type": "string",
            "minLength": 1
        },
        "input_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "output_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
            "enum": [
                "complete",
                "failed",
                "inconclusive",
                "superseded"
            ]
        }
    },
    "additionalProperties": false
}
