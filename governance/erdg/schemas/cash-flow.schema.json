{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "erdg/cash-flow/1.0.0",
    "type": "object",
    "required": [
        "currency",
        "opening_cash",
        "entries"
    ],
    "properties": {
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "opening_cash": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
                "type": "object",
                "required": [
                    "entry_id",
                    "occurred_at",
                    "direction",
                    "amount"
                ],
                "properties": {
                    "entry_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "occurred_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "direction": {
                        "enum": [
                            "inflow",
                            "outflow"
                        ]
                    },
                    "amount": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
