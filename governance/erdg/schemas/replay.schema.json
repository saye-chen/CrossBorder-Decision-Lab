{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "erdg/replay/1.0.0",
    "type": "object",
    "required": [
        "replay_id",
        "state",
        "input_hash",
        "result_hash",
        "authorized",
        "deidentified"
    ],
    "properties": {
        "replay_id": {
            "type": "string"
        },
        "state": {
            "enum": [
                "not_started",
                "evidence_frozen",
                "replayed",
                "independently_reviewed",
                "calibrated",
                "no_change",
                "inconclusive"
            ]
        },
        "input_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "result_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "authorized": {
            "type": "boolean"
        },
        "deidentified": {
            "type": "boolean"
        },
        "production_ready": {
            "const": false
        }
    },
    "additionalProperties": false
}
