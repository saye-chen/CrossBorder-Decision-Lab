{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cbds/platform-knowledge-card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "card_id", "version", "owner_domain", "platform", "surface", "mechanism", "evidence_status", "sources", "valid_from", "reviewed_at", "expires_at", "affected_objects", "allowed_uses", "prohibited_uses", "testable_hypotheses", "invalidation_conditions"],
  "properties": {
    "contract": {"const": "CBDS-PLATFORM-KNOWLEDGE-2026.08"}, "card_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner_domain": {"enum": ["D07", "D08", "D09"]}, "platform": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1},
    "evidence_status": {"enum": ["official", "research", "observed", "inferred"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_type", "url", "published_at", "claim_boundary"], "properties": {"source_id": {"type": "string"}, "source_type": {"enum": ["official", "paper", "authorized_observation", "industry_analysis"]}, "url": {"type": "string", "format": "uri"}, "published_at": {"type": "string", "format": "date"}, "claim_boundary": {"type": "string", "minLength": 1}}}},
    "valid_from": {"type": "string", "format": "date"}, "reviewed_at": {"type": "string", "format": "date"}, "expires_at": {"type": "string", "format": "date"},
    "affected_objects": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "allowed_uses": {"type": "array", "minItems": 1, "items": {"enum": ["diagnostic", "hypothesis", "experiment", "monitoring", "routing"]}},
    "prohibited_uses": {"type": "array", "minItems": 1, "items": {"enum": ["direct_score_change", "automatic_budget_change", "automatic_bid_change", "automatic_replenishment", "automatic_external_write", "causal_claim"]}},
    "testable_hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["hypothesis_id", "change", "metric", "window", "success", "guardrail", "stop"], "properties": {"hypothesis_id": {"type": "string"}, "change": {"type": "string"}, "metric": {"type": "string"}, "window": {"type": "string"}, "success": {"type": "string"}, "guardrail": {"type": "string"}, "stop": {"type": "string"}}}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
