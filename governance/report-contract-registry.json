    },
    {
      "id": "decision_cards",
      "format": "markdown",
      "profile": "card",
      "paths": [
        "category-investment-decision/evaluations/golden/decision-card.md",
        "competitive-intelligence-monitoring/evaluations/golden/decision-card.md",
        "logistics-inventory-fulfillment-decision/evaluations/golden/decision-card.md",
