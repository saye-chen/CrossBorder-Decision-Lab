{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["receipt_id","request_ref","cycle_id","scope_ref","owner","owner_authority","decision","accepted_fields","allowed_uses","packet_version","packet_hash","expires_at","governance","external_write"],"properties":{"receipt_id":{"type":"string","minLength":1},"request_ref":{"type":"string","minLength":1},"cycle_id":{"type":"string","minLength":1},"scope_ref":{"type":"string","minLength":1},"owner":{"type":"string","pattern":"^(D(0[1-9]|1[0-3])|F0[12]|ERDG)$"},"owner_authority":{"type":"string","minLength":1},"decision":{"enum":["accepted","rejected","partially_accepted","blocked","inconclusive"]},"accepted_fields":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"allowed_uses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"packet_version":{"type":"integer","minimum":1},"packet_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"expires_at":{"type":"string","format":"date-time"},"governance":{"$ref":"common.schema.json#/$defs/governance"},"external_write":{"const":false}},"allOf":[{"if":{"properties":{"decision":{"const":"accepted"}},"required":["decision"]},"then":{"properties":{"accepted_fields":{"minItems":1}}}}]}
