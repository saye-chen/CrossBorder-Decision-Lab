    "VALIDATED_VARIANT_GAP": {"display_name": "变体缺口", "not_mean": "纯空白不构成机会"},
    "SEASONAL_PREPOSITIONING_WINDOW": {"display_name": "季节前置", "not_mean": "错过最晚下单日即失效"},
    "REPLICABLE_LOCAL_PREMIUM": {"display_name": "本土溢价机会", "not_mean": "不等于简单中外价差"},
